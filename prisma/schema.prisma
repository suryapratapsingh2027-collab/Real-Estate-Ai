// Real Estate AI Platform — PostgreSQL schema
// Enum values mirror packages/shared/src/enums.ts

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "queryCompiler"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  BROKER
}

enum LeadStatus {
  NEW
  QUALIFIED
  ASSIGNED
  CONTACTED
  INTERESTED
  SITE_VISIT_SCHEDULED
  NEGOTIATION
  CONVERTED
  LOST
}

enum LeadSource {
  WHATSAPP
  VOICE
  MANUAL
  WEBSITE
}

enum PropertyType {
  APARTMENT
  VILLA
  INDEPENDENT_HOUSE
  PLOT
  COMMERCIAL
  OFFICE
  SHOP
  OTHER
}

enum ListingType {
  SALE
  RENT
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum Availability {
  AVAILABLE
  UNDER_OFFER
  SOLD
  RENTED
  INACTIVE
}

enum AreaUnit {
  SQFT
  SQM
  SQYD
  ACRE
}

enum BrokerAvailability {
  AVAILABLE
  BUSY
  ON_LEAVE
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum Urgency {
  IMMEDIATE
  WITHIN_1_MONTH
  WITHIN_3_MONTHS
  EXPLORING
  UNKNOWN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CUSTOMER
  AI
  HUMAN
  SYSTEM
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED_NOT_CONFIGURED
}

enum CallStatus {
  CREATED
  LINK_SENT
  IN_PROGRESS
  COMPLETED
  MISSED
  FAILED
  EXPIRED
}

enum RecordingStatus {
  NOT_REQUESTED
  NO_CONSENT
  UNAVAILABLE
  RECORDING
  AVAILABLE
  FAILED
  DELETED
}

enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
}

enum NotificationChannel {
  WHATSAPP
  IN_APP
}

enum NotificationType {
  BROKER_NEW_LEAD
  CUSTOMER_LEAD_CONFIRMATION
  CUSTOMER_CALL_LINK
  FOLLOW_UP_REMINDER
  LEAD_REASSIGNED
  SYSTEM
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  OK
  ERROR
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  key       String           @unique
  roles     RolePermission[]
  createdAt DateTime         @default(now())
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique
  fullName          String
  passwordHash      String
  roleId            String         @db.Uuid
  role              Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  isActive          Boolean        @default(true)
  isDemo            Boolean        @default(false)
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  brokerProfile     BrokerProfile?
  refreshTokens     RefreshToken[]
  auditLogs         AuditLog[]
  notifications     Notification[] @relation("NotificationRecipientUser")
  leadActivities    LeadActivity[]
  followUpsAssigned FollowUp[]     @relation("FollowUpAssignee")
  followUpsCreated  FollowUp[]     @relation("FollowUpCreator")
  messagesSent      Message[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  familyId   String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Customer {
  id                    String        @id @default(uuid()) @db.Uuid
  fullName              String?
  phone                 String        @unique // E.164
  whatsappNumber        String?       @unique // E.164
  email                 String?
  preferredLanguage     String?
  preferredPropertyType PropertyType?
  budgetRange           String?
  preferredLocation     String?
  notes                 String?
  whatsappConsent       Boolean       @default(false)
  whatsappConsentAt     DateTime?
  isDemo                Boolean       @default(false)
  leads                 Lead[]
  conversations         Conversation[]
  voiceCalls            VoiceCall[]
  notifications         Notification[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([createdAt])
  @@index([fullName])
}

model Property {
  id           String          @id @default(uuid()) @db.Uuid
  code         Int             @unique @default(autoincrement())
  title        String
  description  String?
  propertyType PropertyType
  listingType  ListingType
  location     String
  city         String
  state        String
  address      String?
  bedrooms     Int?
  bathrooms    Int?
  area         Decimal?        @db.Decimal(14, 2)
  areaUnit     AreaUnit        @default(SQFT)
  price        Decimal         @db.Decimal(16, 2)
  priceRange   String?
  furnishing   Furnishing?
  amenities    String[]        @default([])
  availability Availability    @default(AVAILABLE)
  brokerId     String?         @db.Uuid
  broker       BrokerProfile?  @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  images       PropertyImage[]
  isDemo       Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([availability, city])
  @@index([availability, location])
  @@index([propertyType])
  @@index([price])
  @@index([bedrooms])
}

model PropertyImage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  storageKey String
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([propertyId])
}

model BrokerProfile {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @db.Uuid
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String             @unique
  whatsappNumber  String?
  profileImageUrl String?
  /// Lower-cased area/city names the broker covers
  areas           String[]           @default([])
  specialization  PropertyType[]     @default([])
  experienceYears Int                @default(0)
  availability    BrokerAvailability @default(AVAILABLE)
  maxActiveLeads  Int                @default(20)
  status          AccountStatus      @default(ACTIVE)
  lastAssignedAt  DateTime?
  leads           Lead[]
  properties      Property[]
  notifications   Notification[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, availability])
}

model Lead {
  id                String         @id @default(uuid()) @db.Uuid
  number            Int            @unique @default(autoincrement())
  customerId        String         @db.Uuid
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  conversationId    String?        @db.Uuid
  conversation      Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  originalMessage   String?
  propertyType      PropertyType?
  listingType       ListingType?
  budgetRange       String?
  budgetMin         Decimal?       @db.Decimal(16, 2)
  budgetMax         Decimal?       @db.Decimal(16, 2)
  preferredLocation String?
  bedrooms          Int?
  urgency           Urgency        @default(UNKNOWN)
  summary           String?
  source            LeadSource     @default(WHATSAPP)
  isQualified       Boolean        @default(false)
  status            LeadStatus     @default(NEW)
  brokerId          String?        @db.Uuid
  broker            BrokerProfile? @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  assignedAt        DateTime?
  assignmentReason  String?
  followUpAt        DateTime?
  lostReason        String?
  convertedAt       DateTime?
  isDemo            Boolean        @default(false)
  activities        LeadActivity[]
  followUps         FollowUp[]
  voiceCalls        VoiceCall[]
  notifications     Notification[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([customerId])
  @@index([brokerId, status])
  @@index([status, createdAt])
  @@index([preferredLocation])
  @@index([createdAt])
}

model LeadActivity {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      String // CREATED, STATUS_CHANGED, ASSIGNED, NOTE, FOLLOW_UP, CALL, NOTIFICATION, UPDATED
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model Conversation {
  id               String    @id @default(uuid()) @db.Uuid
  customerId       String    @unique @db.Uuid
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel          String    @default("WHATSAPP")
  lastMessageAt    DateTime?
  lastInboundAt    DateTime?
  lastMessageText  String?
  humanTakeover    Boolean   @default(false)
  takeoverById     String?   @db.Uuid
  takeoverAt       DateTime?
  summary          String?
  summaryUpdatedAt DateTime?
  unreadCount      Int       @default(0)
  messages         Message[]
  leads            Lead[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([lastMessageAt])
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  conversationId    String           @db.Uuid
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection
  sender            MessageSender
  senderUserId      String?          @db.Uuid
  senderUser        User?            @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  body              String
  messageType       String           @default("text")
  whatsappMessageId String?          @unique
  status            MessageStatus
  error             String?
  aiMeta            Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([conversationId, createdAt])
}

model VoiceCall {
  id                String          @id @default(uuid()) @db.Uuid
  leadId            String?         @db.Uuid
  lead              Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId        String          @db.Uuid
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  roomName          String          @unique
  joinCodeHash      String          @unique
  joinExpiresAt     DateTime
  status            CallStatus      @default(CREATED)
  startedAt         DateTime?
  endedAt           DateTime?
  durationSeconds   Int?
  summary           String?
  propertyType      String?
  budget            String?
  preferredLocation String?
  urgency           String?
  recordingConsent  Boolean         @default(false)
  recordingStatus   RecordingStatus @default(NOT_REQUESTED)
  recordingKey      String?
  egressId          String?
  recordingDeleteAt DateTime?
  failureReason     String?
  transcript        CallTranscript?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([leadId])
  @@index([customerId])
  @@index([status, createdAt])
}

model CallTranscript {
  id        String    @id @default(uuid()) @db.Uuid
  callId    String    @unique @db.Uuid
  call      VoiceCall @relation(fields: [callId], references: [id], onDelete: Cascade)
  /// [{ role: "user" | "assistant", text, at }]
  segments  Json
  fullText  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model FollowUp {
  id          String         @id @default(uuid()) @db.Uuid
  leadId      String         @db.Uuid
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeId  String?        @db.Uuid
  assignee    User?          @relation("FollowUpAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?        @db.Uuid
  createdBy   User?          @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title       String
  description String?
  dueAt       DateTime
  status      FollowUpStatus @default(PENDING)
  remindedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, dueAt])
  @@index([assigneeId, status])
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  type              NotificationType
  channel           NotificationChannel
  recipientUserId   String?             @db.Uuid
  recipientUser     User?               @relation("NotificationRecipientUser", fields: [recipientUserId], references: [id], onDelete: SetNull)
  brokerId          String?             @db.Uuid
  broker            BrokerProfile?      @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  customerId        String?             @db.Uuid
  customer          Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leadId            String?             @db.Uuid
  lead              Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  toAddress         String?
  title             String
  body              String
  status            MessageStatus       @default(QUEUED)
  whatsappMessageId String?             @unique
  attempts          Int                 @default(0)
  lastError         String?
  readAt            DateTime?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([recipientUserId, readAt])
  @@index([status])
  @@index([leadId])
}

model Integration {
  id            String            @id @default(uuid()) @db.Uuid
  key           String            @unique // whatsapp | groq | livekit | tts | storage
  name          String
  enabled       Boolean           @default(true)
  /// Non-secret configuration
  config        Json              @default("{}")
  /// AES-256-GCM encrypted JSON of secret values (never returned by API)
  secretsCipher String?
  status        IntegrationStatus @default(NOT_CONFIGURED)
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model BusinessSetting {
  key       String   @id // "business" | "ai"
  value     Json
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  ip         String?
  userAgent  String?
  data       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// Idempotency ledger for inbound webhooks (WhatsApp message ids, LiveKit event ids)
model ProcessedWebhookEvent {
  id        String   @id // provider:eventId
  provider  String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FailedJob {
  id        String   @id @default(uuid()) @db.Uuid
  queue     String
  jobName   String
  jobId     String?
  data      Json?
  error     String
  attempts  Int
  createdAt DateTime @default(now())

  @@index([queue, createdAt])
}
